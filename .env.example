APP_NAME="网络安全学生考核平台"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://exam.example.com
APP_TIMEZONE=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyber_exam
DB_USERNAME=cyber_exam
DB_PASSWORD=change_this_password

# 必须分别生成，不能相同。建议：openssl rand -hex 32 / openssl rand -hex 64
STUDENT_KEY_SECRET=replace_with_64_hex_chars
ADMIN_KEY_SECRET=replace_with_128_hex_chars

SESSION_NAME=cyber_exam_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# 内网 HTTP 使用 false；HTTPS 使用 true；默认 auto 会按实际请求协议判断。
SESSION_SECURE_COOKIE=auto
SESSION_SAME_SITE=Lax
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000
UPLOAD_MAX_PER_ANSWER=5
